{
  "name": "public",
  "version": "1.0.0",
  "description": "",
  "main": "electron_main.js",
  "scripts": {
    "start:words": "node scripts/experimental/launch.js",
    "start:word": "node scripts/experimental/launch.js",
    "start:web:words": "node scripts/experimental/serve.js",
    "test:words": "node --test tests/experimental_word_learning.test.js tests/experimental_word_electron.test.js tests/experimental_word_island.test.js",
    "start": "electron .",
    "start:web": "node browser_server.js",
    "start:web:lan": "node browser_server.js --host 0.0.0.0",
    "build": "npm run build:full",
    "build:full": "electron-builder --windows --config scripts/release/full.cjs",
    "build:full:offline": "electron-builder --windows --config scripts/release/full-offline.cjs",
    "build:demo": "electron-builder --windows --config scripts/release/demo.cjs",
    "start:demo": "electron . --release-profile=demo",
    "start:full:offline": "electron . --release-profile=full-offline",
    "start:web:demo": "node browser_server.js --release-profile=demo --port 4174",
    "start:web:full:offline": "node browser_server.js --release-profile=full-offline",
    "i18n:extract": "node scripts/i18n/extract_catalog.js",
    "i18n:translate": "node scripts/i18n/translate_catalog.js",
    "i18n:build": "node scripts/i18n/build_runtime_catalog.js",
    "i18n:check": "node scripts/i18n/check_localization.js"
  },
  "build": {
    "appId": "com.yourname.aipetgame",
    "productName": "AIPetGame",
    "win": {
      "target": [
        "dir"
      ],
      "icon": "icon.ico",
      "signAndEditExecutable": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reina4256-prog/public.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/reina4256-prog/public/issues"
  },
  "homepage": "https://github.com/reina4256-prog/public#readme",
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
